# 复制到服务器 /etc/dsh/dsh.env，权限设为 600
#   chmod 600 /etc/dsh/dsh.env

# 必填：DeepSeek API Key（模型对话 + 联网搜索共用）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填你的key

# 监听地址：保持 127.0.0.1，通过 SSH 隧道访问，不要暴露到公网
DSH_WEB_HOST=127.0.0.1
DSH_WEB_PORT=3080

# 可选：走别的模型服务时，配合 profile 里的 provider 配置使用
# DSH_MODEL_PROVIDER=
